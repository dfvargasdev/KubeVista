{
  "extends": null,
  "appId": "com.dfvargasdev.kubevista",
  "productName": "KubeVista",
  "copyright": "Copyright © 2026 Diego Vargas (dfVargasDev)",
  "icon": "build/icon",
  "files": [
    "dist/**/*",
    "node_modules/**/*",
    "build/**/*"
  ],
  "extraResources": [
    {
      "from": "build/icon.ico",
      "to": "icon.ico"
    }
  ],
  "directories": {
    "buildResources": "build",
    "output": "out"
  },
  "win": {
    "icon": "build/icon.ico",
    "artifactName": "KubeVista-${version}-win-x64.${ext}",
    "target": [
      {
        "target": "zip",
        "arch": ["x64"]
      },
      {
        "target": "dir",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "artifactName": "KubeVista-${version}-win-x64-setup.${ext}",
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "installerHeaderIcon": "build/icon.ico",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "KubeVista"
  },
  "portable": {
    "artifactName": "KubeVista-${version}-win-x64-portable.${ext}"
  },
  "mac": {
    "icon": "build/icon.png",
    "artifactName": "KubeVista-${version}.${ext}",
    "target": ["dmg", "zip"]
  },
  "linux": {
    "icon": "build/icon.png",
    "artifactName": "KubeVista-${version}.${ext}",
    "target": ["AppImage", "deb"]
  }
}
