{
  "extends": null,
  "appId": "com.pichincha.lens-alternativa",
  "productName": "Lens Alternativa",
  "copyright": "Copyright © 2026 Banco Pichincha",
  "icon": "build/icon",
  "files": [
    "dist/**/*",
    "node_modules/**/*",
    "build/**/*"
  ],
  "extraResources": [
    {
      "from": "build/icon.ico",
      "to": "icon.ico"
    }
  ],
  "directories": {
    "buildResources": "build",
    "output": "out"
  },
  "win": {
    "icon": "build/icon.ico",
    "artifactName": "LensAlternativa-${version}-win-x64.${ext}",
    "target": [
      {
        "target": "zip",
        "arch": ["x64"]
      },
      {
        "target": "dir",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "installerIcon": "build/icon.ico",
    "uninstallerIcon": "build/icon.ico",
    "installerHeaderIcon": "build/icon.ico",
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Lens Alternativa"
  },
  "mac": {
    "icon": "build/icon.png",
    "artifactName": "LensAlternativa-${version}.${ext}",
    "target": ["dmg", "zip"]
  },
  "linux": {
    "icon": "build/icon.png",
    "artifactName": "LensAlternativa-${version}.${ext}",
    "target": ["AppImage", "deb"]
  }
}
